<text xml:space="preserve"  xml:id="gb11827_source_hwit1310" corresp="#gb11827_header_hwit1310" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11827/22790"/>
      <p>
        <anchor xml:id="GB03_1_BR327_0_195_021"/>Es ist doch hübsch von Ihnen dass Sie den den Sie nicht mehr lieben 
<anchor xml:id="GB03_1_BR327_0_195_022"/>doch mit eingemachten Früchten nähren wollen. Dafür danck ich. 
<anchor xml:id="GB03_1_BR327_0_195_023"/>Obs gleich aussieht als wenn Sie mir Gerichte schickten <ref target="gb:note#GB03_2_BR327_0_note_001_195_23-24" xml:id="start_com_2973"/>damit ich 
<anchor xml:id="GB03_1_BR327_0_195_024"/>nicht kommen solle<ref xml:id="end_com_2973"/> sie<ptr n="1" target="#a001_195.24"/> bey Ihnen zu verzehren  d<g ref="#typoSuspension"/>. 1 Febr 78</p>
      <closer>
        <anchor xml:id="GB03_1_BR327_0_195_025"/>
        <signed rend="paraph" rendition="#einrueck19">G.</signed>
      </closer>
    </div>
    
  </body>
</text>


