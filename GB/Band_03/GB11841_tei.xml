  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11841/22825"/>
      <p>
        <anchor xml:id="GB03_1_BR349_0_204_001"/>
        <ref target="gb:note#GB03_2_BR349_0_note_001_204_1" xml:id="start_com_3099"/>Eh ich abgehe<ref xml:id="end_com_3099"/> schicke ich noch einen Straus und <ref target="gb:note#GB03_2_BR349_0_note_002_204_1" xml:id="start_com_3100"/>Bohn<ref xml:id="end_com_3100"/>. da <ref target="gb:note#GB03_2_BR349_0_note_003_204_1-2" xml:id="start_com_3101"/>mein Würdiger 
<anchor xml:id="GB03_1_BR349_0_204_002"/>Freund<ref xml:id="end_com_3101"/> noch einen Plaz übrig hat, so fahr ich mit demselbigen<ptr n="1" target="#a001_204.2"/>
        <anchor xml:id="GB03_1_BR349_0_204_003"/>hinüber. Adieu lieb <ref target="gb:note#GB03_2_BR349_0_note_004_204_3" xml:id="start_com_3102"/>Gold<ref xml:id="end_com_3102"/> dancke für gestern Abend. Grüsen Sie <ref target="gb:note#GB03_2_BR349_0_note_005_204_3-4" xml:id="start_com_3103"/>Steinen<ref xml:id="end_com_3103"/>.
<anchor xml:id="GB03_1_BR349_0_204_004"/>    d<g ref="#typoSuspension"/>. 21. Apr 78.</p>
      <closer>
        <anchor xml:id="GB03_1_BR349_0_204_005"/>
        <signed rend="paraph" rendition="#einrueck18">G.</signed>
      </closer>
    </div>
    
  </body>
</text>


