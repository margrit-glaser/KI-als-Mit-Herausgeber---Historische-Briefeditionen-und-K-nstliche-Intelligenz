<text xml:space="preserve"  xml:id="gb11662_source_hwit1197" corresp="#gb11662_header_hwit1197" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11662/22598"/>
      <p>
        <anchor xml:id="GB03_1_BR259_0_145_006"/>Da schick ich Ihnen <ref target="gb:note#GB03_2_BR259_0_note_001_145_6" xml:id="start_com_2239"/>die Kleinen wieder<ref xml:id="end_com_2239"/> sie mögen unsre <ref target="gb:note#GB03_2_BR259_0_note_002_145_6" xml:id="start_com_2240"/>Wirthschafft<ref xml:id="end_com_2240"/>
        <anchor xml:id="GB03_1_BR259_0_145_007"/>erzählen, und den besten Morgen! <ref target="gb:note#GB03_2_BR259_0_note_003_145_7" xml:id="start_com_2241"/>An der gestrigen Unterschrifft<ref xml:id="end_com_2241"/> hab 
<anchor xml:id="GB03_1_BR259_0_145_008"/>ich doch gesehen dass Sie mich nicht mit bösen Geistern verwandt 
<anchor xml:id="GB03_1_BR259_0_145_009"/>halten.    Adieu Beste.   d<g ref="#typoSuspension"/>. 5 Mai 77.</p>
      <closer>
        <anchor xml:id="GB03_1_BR259_0_145_010"/>
        <signed rend="paraph" rendition="#einrueck18">G</signed>
      </closer>
    </div>
  </body>
</text>


