<text xml:space="preserve"  xml:id="gb11750_source_hwit1540" corresp="#gb11750_header_hwit1540" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11750/13966"/>
      <opener>
        <dateline rendition="#einrueck13">
          <anchor xml:id="GB03_1_BR547_0_342_022"/>d<g ref="#typoSuspension"/>. 14 Nov. 79.</dateline>
        <dateline rendition="#einrueck5">
          <anchor xml:id="GB03_1_BR547_0_342_023"/>
          <ref target="gb:note#GB03_2_BR547_0_note_001_342_22" xml:id="start_com_4919"/>Auf dem Gotthart bey den Capuzinern.<ref xml:id="end_com_4919"/>
        </dateline>
      </opener>
      <space quantity="1" unit="lines"/>
      <p>
        <anchor xml:id="GB03_1_BR547_0_342_024"/>
        <ref target="gb:note#GB03_2_BR547_0_note_002_342_24" xml:id="start_com_4920"/>Eh wir absteigen<ref xml:id="end_com_4920"/> dir einen guten Morgen <ref target="gb:note#GB03_2_BR547_0_note_003_342_24" xml:id="start_com_4921"/>l. Br.<ref xml:id="end_com_4921"/>
      </p>
      <p rendition="#einrueck1">
        <anchor xml:id="GB03_1_BR547_0_342_025"/>
        <ref target="gb:note#GB03_2_BR547_0_note_004_342_25-27" xml:id="start_com_4922"/>Seit Genf haben wir das Thal Chamouny<ptr n="1" target="#a001_342.25"/> durchstrichen, sind von da 
<anchor xml:id="GB03_1_BR547_0_342_026"/>ins Wallis gefallen habens aufwärts ganz durchzogen, und sind endlich 
<anchor xml:id="GB03_1_BR547_0_342_027"/>über die Furcka hier angekommen.<ref xml:id="end_com_4922"/> Mit dem preiswürdigsten Glücke 
<anchor xml:id="GB03_1_BR547_0_343_001"/>durch die erhabensten Gegenden. Nun l. Br gehts nach<ptr n="2" target="#a002_343.1"/> dir zu. <ref target="gb:note#GB03_2_BR547_0_note_005_343_1-2" xml:id="start_com_4923"/>Den 
<anchor xml:id="GB03_1_BR547_0_343_002"/>19 od<g ref="#typoSuspension"/>. 20 bin ich bey dir<ref xml:id="end_com_4923"/>, und so steht mir das Liebste von der ganzen 
<anchor xml:id="GB03_1_BR547_0_343_003"/>Reise noch vor. mache mir ein Bett zurechte <ref target="gb:note#GB03_2_BR547_0_note_006_343_3-4" xml:id="start_com_4924"/>dass ich allenfalls bey dir 
<anchor xml:id="GB03_1_BR547_0_343_004"/>übernachte<ref xml:id="end_com_4924"/>. Grüs <ref target="gb:note#GB03_2_BR547_0_note_007_343_4" xml:id="start_com_4925"/>deine Frau<ref xml:id="end_com_4925"/> und theile meine Freude.    G.</p>
    <pb n="2" facs="gb:digitalisate#11750/13967" type="empty"/>
