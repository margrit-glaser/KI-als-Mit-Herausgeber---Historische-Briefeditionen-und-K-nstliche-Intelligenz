  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11395/22516"/>
      <p>
        <anchor xml:id="GB03_1_BR206_0_124_009"/>
        <ref target="gb:note#GB03_2_BR206_0_note_001_124_9" xml:id="start_com_1906"/>Indess Sie lustig waren<ref xml:id="end_com_1906"/>, war ich fleisig, hier haben Sie <ref target="gb:note#GB03_2_BR206_0_note_002_124_9" xml:id="start_com_1907"/>ein Stück<ref xml:id="end_com_1907"/>. Ich 
<anchor xml:id="GB03_1_BR206_0_124_010"/>bin wieder <ref target="gb:note#GB03_2_BR206_0_note_003_124_10" xml:id="start_com_1908"/>ganz leidlich<ref xml:id="end_com_1908"/>
        <ref target="gb:note#GB03_2_BR206_0_note_004_124_10" xml:id="start_com_1909"/>komme wohl heut zu Ihnen<ref xml:id="end_com_1909"/>. Leben sie froh 
<anchor xml:id="GB03_1_BR206_0_124_011"/>bis dahin.    d<g ref="#typoSuspension"/>. 4 Jan 77<ptr n="1" target="#a001_124.11"/>.</p>
      <closer>
        <anchor xml:id="GB03_1_BR206_0_124_012"/>
        <signed rend="signature" rendition="#einrueck21">Goethe.</signed>
      </closer>
    </div>
    
  </body>
</text>


