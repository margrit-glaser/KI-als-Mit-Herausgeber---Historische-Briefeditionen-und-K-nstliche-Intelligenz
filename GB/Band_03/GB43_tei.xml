  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#43/12068"/>
      <p>
        <anchor xml:id="GB03_1_BR452_0_255_001"/>Hierbey kommen <ref target="gb:note#GB03_2_BR452_0_note_001_255_1" xml:id="start_com_3707"/>fünf Louisdor<ref xml:id="end_com_3707"/>. Ich bitte Sie indess geduld zu haben 
<anchor xml:id="GB03_1_BR452_0_255_002"/>kan ich mehr für Sie thun will ich’s gerne.</p>
      <p rendition="#einrueck1">
        <anchor xml:id="GB03_1_BR452_0_255_003"/>
        <ref target="gb:note#GB03_2_BR452_0_note_002_255_3" xml:id="start_com_3708"/>Ich erwarte die Fortsezzung Ihres Lebens, dancke für Ihr Vertrauen.<ref xml:id="end_com_3708"/>
      </p>
      <closer>
        <dateline rendition="#einrueck11">
          <anchor xml:id="GB03_1_BR452_0_255_004"/>d<g ref="#typoSuspension"/>. 3 Jan 79</dateline>
        <anchor xml:id="GB03_1_BR452_0_255_005"/>
        <signed rend="paraph" rendition="#einrueck17">G.</signed>
      </closer>
    <pb n="2" facs="gb:digitalisate#43/28229"/>
    </div>
  </body>
</text>


