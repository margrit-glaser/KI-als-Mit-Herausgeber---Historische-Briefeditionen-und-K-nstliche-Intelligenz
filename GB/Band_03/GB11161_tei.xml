<text xml:space="preserve"  xml:id="gb11161_source_hwit1047" corresp="#gb11161_header_hwit1047" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11161/22443"/>
      <p>
        <anchor xml:id="GB03_1_BR162_0_101_010"/>Wie haben Sie geschlafen beste. <ref target="gb:note#GB03_2_BR162_0_note_001_101_10" xml:id="start_com_1562"/>Mir wars gestern sehr wohl um Sie!<ref xml:id="end_com_1562"/>
        <anchor xml:id="GB03_1_BR162_0_101_011"/>Es war Ihnen auch<ptr n="1" target="#a001_101.11"/> lieb ums herz dünckt mich. Sagen Sie mir ein 
<anchor xml:id="GB03_1_BR162_0_101_012"/>Wort. Ich lies gestern bey Ihnen <ref target="gb:note#GB03_2_BR162_0_note_002_101_12" xml:id="start_com_1563"/>Papiere<ref xml:id="end_com_1563"/> schicken Sie mir sie doch versiegelt.
<anchor xml:id="GB03_1_BR162_0_101_013"/>
      </p>
      <closer>
        <dateline rendition="#einrueck9">
          <anchor xml:id="GB03_1_BR162_0_101_014"/>d<g ref="#typoSuspension"/>. 30 Aug 76.     </dateline>
        <signed rend="paraph">G.</signed>
      </closer>
    </div>
    
  </body>
</text>


