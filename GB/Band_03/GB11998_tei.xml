<text xml:space="preserve"  xml:id="gb11998_source_hwit1495" corresp="#gb11998_header_hwit1495" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11998/23075"/>
      <p>
        <anchor xml:id="GB03_1_BR507_0_282_001"/>Gestern Abend hatt ich Ihnen <ref target="gb:note#GB03_2_BR507_0_note_001_282_1" xml:id="start_com_4060"/>noch eine Rose gebrochen<ref xml:id="end_com_4060"/> die unterm 
<anchor xml:id="GB03_1_BR507_0_282_002"/>Busch aufgeblüht war. Ich wurd aber unterweegs <ref target="gb:note#GB03_2_BR507_0_note_002_282_2" xml:id="start_com_4061"/>aufgefangen<ref xml:id="end_com_4061"/>, und 
<anchor xml:id="GB03_1_BR507_0_282_003"/>musste sie wieder mit nach hause nehmen.</p>
      <p rendition="#einrueck1">
        <anchor xml:id="GB03_1_BR507_0_282_004"/>Wenns Regen giebt blühen ganze Kränze auf. Gehn sie heut zur 
<anchor xml:id="GB03_1_BR507_0_282_005"/>
        <ref target="gb:note#GB03_2_BR507_0_note_003_282_5" xml:id="start_com_4062"/>Militair Operation<ref xml:id="end_com_4062"/>?</p>
      <closer>
        <dateline rendition="#einrueck3">
          <anchor xml:id="GB03_1_BR507_0_282_006"/>d<g ref="#typoSuspension"/>. 9 Jun 79.                        </dateline>
        <signed rend="paraph">G.</signed>
      </closer>
    </div>
  </body>
</text>


