          <ref target="gb:note#GB03_2_ZB005_0_note_001_447_8" xml:id="start_com_5261"/>Ich bin eben nirgend geborgen<ref xml:id="end_com_5261"/>
        </l>
        <anchor xml:id="GB03_1_ZB005_0_447_009"/>
        <l rendition="#einrueck6">Fern an die holde Saale hier</l>
        <anchor xml:id="GB03_1_ZB005_0_447_010"/>
        <l rendition="#einrueck6">Verfolgen mich manche Sorgen</l>
        <anchor xml:id="GB03_1_ZB005_0_447_011"/>
        <l rendition="#einrueck6">Und <ref target="gb:note#GB03_2_ZB005_0_note_002_447_11" xml:id="start_com_5262"/>meine Liebe zu dir<ref xml:id="end_com_5262"/>
        </l>
      </lg>
