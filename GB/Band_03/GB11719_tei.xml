<text xml:space="preserve"  xml:id="gb11719_source_hwit1380" corresp="#gb11719_header_hwit1380" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11719/22899"/>
      <p>
        <anchor xml:id="GB03_1_BR386_0_219_001"/>So gern ich Ihnen <ref target="gb:note#GB03_2_BR386_0_note_001_219_1" xml:id="start_com_3316"/>Knebels Gegenwart<ref xml:id="end_com_3316"/> zu Ihrer Andacht gonnte, will 
<anchor xml:id="GB03_1_BR386_0_219_002"/>er doch lieber <ref target="gb:note#GB03_2_BR386_0_note_002_219_2" xml:id="start_com_3317"/>unter dem hohen Gewölbe des Himmels<ref xml:id="end_com_3317"/> heute anbeten. 
<anchor xml:id="GB03_1_BR386_0_219_003"/>Dancke für die <ref target="gb:note#GB03_2_BR386_0_note_003_219_3" xml:id="start_com_3318"/>Schokolade<ref xml:id="end_com_3318"/>, von Ihren Händen nehm ich auch 
<anchor xml:id="GB03_1_BR386_0_219_004"/>wohl <ref target="gb:note#GB03_2_BR386_0_note_004_219_4" xml:id="start_com_3319"/>was schädlich ist<ref xml:id="end_com_3319"/>. Adieu ich liebe Sie<ptr n="1" target="#a001_219.4"/> immer gleich adieu lieber 
<anchor xml:id="GB03_1_BR386_0_219_005"/>Engel. G.   d<g ref="#typoSuspension"/> 2 Aug<ptr n="2" target="#a002_219.5"/> 78.</p>
      <p rendition="#einrueck1">
        <anchor xml:id="GB03_1_BR386_0_219_006"/>aus der <ref target="gb:note#GB03_2_BR386_0_note_005_219_6" xml:id="start_com_3320"/>Einsiedeley<ref xml:id="end_com_3320"/>
      </p>
    </div>
    
  </body>
</text>


