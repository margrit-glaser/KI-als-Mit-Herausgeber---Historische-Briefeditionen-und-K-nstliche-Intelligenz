      <lg type="poem">
        <anchor xml:id="GB03_1_BR439_0_249_006"/><head rendition="#einrueck9">Malchen Hendrich.</head>
      <space quantity="1" unit="lines"/>
         <anchor xml:id="GB03_1_BR439_0_249_007"/>
        <l rendition="#einrueck9">In deinem Herzen</l>
        <anchor xml:id="GB03_1_BR439_0_249_008"/>
        <l rendition="#einrueck9">Ist nicht viel Plaz,</l>
        <anchor xml:id="GB03_1_BR439_0_249_009"/>
        <l rendition="#einrueck9">drum alle acht Tage</l>
        <anchor xml:id="GB03_1_BR439_0_249_010"/>
        <l rendition="#einrueck9">Einen neuen Schaz.</l>
      </lg>
    </div>
  </body>
</text>


