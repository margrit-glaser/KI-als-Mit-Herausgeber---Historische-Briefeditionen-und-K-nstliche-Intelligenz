    <pb n="1" facs="gb:digitalisate#12125/22986"/>
      <p>
        <anchor xml:id="GB03_1_BR453_0_255_006"/>Noch einen guten Morgen und <ref target="gb:note#GB03_2_BR453_0_note_001_255_6" xml:id="start_com_3710"/>Ade<ref xml:id="end_com_3710"/>! <ref target="gb:note#GB03_2_BR453_0_note_002_255_6-7" xml:id="start_com_3711"/>Gestern Nacht wars herrlich 
<anchor xml:id="GB03_1_BR453_0_255_007"/>um’s dampfende Wasser im Mondschein.<ref xml:id="end_com_3711"/> Heute noch herrlicher nur 
<anchor xml:id="GB03_1_BR453_0_255_008"/>
        <ref target="gb:note#GB03_2_BR453_0_note_003_255_8" xml:id="start_com_3712"/>unendlich<ptr n="1" target="#a001_255.8"/> kalt<ref xml:id="end_com_3712"/>. Dencken Sie mein Addio bestes.</p>
      <closer>
        <anchor xml:id="GB03_1_BR453_0_255_009"/>
        <signed rend="paraph" rendition="#einrueck17">G.</signed>
      </closer>
    <pb n="2" facs="gb:digitalisate#12125/22987"/>
    </div>
    
