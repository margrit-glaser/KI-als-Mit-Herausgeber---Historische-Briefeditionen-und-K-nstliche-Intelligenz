<text xml:space="preserve"  xml:id="gb11991_source_hwit1485" corresp="#gb11991_header_hwit1485" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11991/23060"/>
      <p>
        <anchor xml:id="GB03_1_BR497_0_277_016"/>Von denen <ref target="gb:note#GB03_2_BR497_0_note_001_277_16" xml:id="start_com_4004"/>zwey Exemplaren<ref xml:id="end_com_4004"/> schicken Sie ein’s der <ref target="gb:note#GB03_2_BR497_0_note_002_277_16" xml:id="start_com_4005"/>Waldnern<ref xml:id="end_com_4005"/>. Da<ptr n="1" target="#a001_277.16"/> Sie 
<anchor xml:id="GB03_1_BR497_0_277_017"/>
        <ref target="gb:note#GB03_2_BR497_0_note_003_277_17" xml:id="start_com_4006"/>kleine Herzgen durch mich verschencken<ref xml:id="end_com_4006"/>, ist’s billig dass ich Sie zur 
<anchor xml:id="GB03_1_BR497_0_277_018"/>Austheilerinn<ptr n="2" target="#a002_277.18"/> meiner Geringen Geists Produckte mache. Adieu Liebste. 
<anchor xml:id="GB03_1_BR497_0_277_019"/>Ich habe <ref target="gb:note#GB03_2_BR497_0_note_004_277_19" xml:id="start_com_4007"/>das Zeug<ref xml:id="end_com_4007"/> heute früh durchgeblattert, es dünckt einen 
<anchor xml:id="GB03_1_BR497_0_277_020"/>sonderbaar wenn man die alt abgelegten Schlangenhäute auf dem weisen 
<anchor xml:id="GB03_1_BR497_0_277_021"/>Papier aufgezogen findet. d<g ref="#typoSuspension"/>. 14 May 1779</p>
      <closer>
        <anchor xml:id="GB03_1_BR497_0_277_022"/>
        <signed rend="paraph" rendition="#einrueck21">G.</signed>
      </closer>
    </div>
    
  </body>
</text>


