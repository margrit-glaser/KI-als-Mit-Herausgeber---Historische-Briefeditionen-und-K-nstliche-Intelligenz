<text xml:space="preserve"  xml:id="gb11886_source_hwit1393" corresp="#gb11886_header_hwit1393" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11886/22919"/>
      <opener>
        <dateline rendition="#einrueck3">
          <anchor xml:id="GB03_1_BR400_0_229_001"/>
          <ref target="gb:note#GB03_2_BR400_0_note_001_229_1" xml:id="start_com_3453"/>d<g ref="#typoSuspension"/>. 8 S. 78.<ref xml:id="end_com_3453"/>
        </dateline>
      </opener>
      <p>
        <anchor xml:id="GB03_1_BR400_0_229_002"/>Ihr schlimmes <ref target="gb:note#GB03_2_BR400_0_note_002_229_2" xml:id="start_com_3454"/>Reise Wetter<ref xml:id="end_com_3454"/> hab ich bedauert, und hoffte noch auf ein 
<anchor xml:id="GB03_1_BR400_0_229_003"/>rückgelassnes Zettelgen von Ihnen. Es war Ihnen aber nicht so. Heut 
<anchor xml:id="GB03_1_BR400_0_229_004"/>früh besucht ich das <ref target="gb:note#GB03_2_BR400_0_note_003_229_4" xml:id="start_com_3455"/>Bauwesen<ref xml:id="end_com_3455"/>. Blieb dann einmal, o Wunder! bey 
<anchor xml:id="GB03_1_BR400_0_229_005"/>mir. Sezte mich an mein Küchen feuer und las den <ref target="gb:note#GB03_2_BR400_0_note_004_229_5" xml:id="start_com_3456"/>Cardan<ref xml:id="end_com_3456"/> wieder 
<anchor xml:id="GB03_1_BR400_0_229_006"/>einmal, mit vieler Freude und Rührung. Gute Nacht.<ref target="gb:note#GB03_2_BR400_0_note_005_229_6" xml:id="start_com_3457"/> d<g ref="#typoSuspension"/> 8 S.<ref xml:id="end_com_3457"/>
      </p>
    </div>
  </body>
</text>


