<text xml:space="preserve"  xml:id="gb11663_source_hwit1198" corresp="#gb11663_header_hwit1198" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11663/22600"/>
      <p>
        <anchor xml:id="GB03_1_BR260_0_145_011"/>Sie müssen viel <ref target="gb:note#GB03_2_BR260_0_note_001_145_11" xml:id="start_com_2243"/>draussen in der Welt<ref xml:id="end_com_2243"/> zu suchen haben dass Sie nicht 
<anchor xml:id="GB03_1_BR260_0_145_012"/>einmal die Paar Tage da Sie so <ref target="gb:note#GB03_2_BR260_0_note_002_145_12" xml:id="start_com_2244"/>nach Kochberg gehn<ref xml:id="end_com_2244"/> warten können. 
<anchor xml:id="GB03_1_BR260_0_145_013"/>Ich sage aber nichts drüber. Und <ref target="gb:note#GB03_2_BR260_0_note_003_145_13" xml:id="start_com_2245"/>komme wohl<ref xml:id="end_com_2245"/>.   d<g ref="#typoSuspension"/>. 5. May 77.</p>
      <closer>
        <anchor xml:id="GB03_1_BR260_0_145_014"/>
        <signed rend="paraph" rendition="#einrueck23">G</signed>
      </closer>
    </div>
  </body>
</text>


