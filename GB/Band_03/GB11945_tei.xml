  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11945/22982"/>
      <lg type="poem">
        <anchor xml:id="GB03_1_BR428_0_244_006"/><head rendition="#einrueck8">
        <emph rendition="#latin">
          <ref target="gb:note#GB03_2_BR428_0_note_001_244_6-7" xml:id="start_com_3665"/>Zum neuen Jahr.</emph>
      </head>
      <head rendition="#einrueck10">
        <anchor xml:id="GB03_1_BR428_0_244_007"/>
        <emph rendition="#latin">1779.</emph>
        <ref xml:id="end_com_3665"/>
      </head>
      <space quantity="1" unit="lines"/>
      <lg>
        <anchor xml:id="GB03_1_BR428_0_244_008"/>
        <l rendition="#einrueck3">
          <emph rendition="#latin">Du machst die Alten iung die Jungen alt</emph>
        </l>
        <anchor xml:id="GB03_1_BR428_0_244_009"/>
        <l rendition="#einrueck3">
          <emph rendition="#latin">Die Kalten warm die Warmen kalt</emph>
        </l>
        <anchor xml:id="GB03_1_BR428_0_244_010"/>
        <l rendition="#einrueck3">
          <emph rendition="#latin">Bist ernst im Scherz, der Ernst macht dich zu lachen.</emph>
        </l>
        <anchor xml:id="GB03_1_BR428_0_244_011"/>
        <l rendition="#einrueck3">
          <emph rendition="#latin">Dir gab aufs menschliche Geschlecht</emph>
        </l>
        <anchor xml:id="GB03_1_BR428_0_244_012"/>
        <l rendition="#einrueck3">
          <emph rendition="#latin">Ein süsser Gott sein längst bewährtes Recht</emph>
        </l>
        <anchor xml:id="GB03_1_BR428_0_244_013"/>
        <l rendition="#einrueck3">
          <emph rendition="#latin">Aus Weh ihr Wohl aus Wohl ihr Weh zu machen.</emph>
        </l>
      </lg></lg>
      <p rendition="#einrueck12">
        <anchor xml:id="GB03_1_BR428_0_244_014"/>
        <milestone rendition="#einfache_linie_achtel" unit="absent"/>
      </p>
    </div>
  </body>
</text>


