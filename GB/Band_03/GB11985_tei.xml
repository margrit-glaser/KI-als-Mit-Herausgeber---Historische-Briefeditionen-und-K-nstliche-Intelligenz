<text xml:space="preserve"  xml:id="gb11985_source_hwit1497" corresp="#gb11985_header_hwit1497" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11985/23078"/>
      <p>
        <anchor xml:id="GB03_1_BR509_0_282_015"/>Ich habe <ref target="gb:note#GB03_2_BR509_0_note_001_282_15" xml:id="start_com_4070"/>wieder die Medizin zu hülfe gerufen<ref xml:id="end_com_4070"/>, so lang sie als Schlotfeger 
<anchor xml:id="GB03_1_BR509_0_282_016"/>zu würcken hat hab ich immer Vertrauen auf sie.</p>
      <p rendition="#einrueck1">
        <anchor xml:id="GB03_1_BR509_0_282_017"/>Aus Ihrer <ref target="gb:note#GB03_2_BR509_0_note_002_282_17" xml:id="start_com_4071"/>Tasse<ref xml:id="end_com_4071"/> trinck ich Bouillon und schicke Ihnen<ptr n="1" target="#a001_282.17"/>
        <ref target="gb:note#GB03_2_BR509_0_note_003_282_17-18" xml:id="start_com_4072"/>in dem erwünschten<ptr n="2" target="#a002_282.18"/>
        <anchor xml:id="GB03_1_BR509_0_282_018"/>Regen aufgeblühte Blumen<ref xml:id="end_com_4072"/>    d<g ref="#typoSuspension"/>. 13 Jun. 1779.</p>
      <closer>
        <anchor xml:id="GB03_1_BR509_0_282_019"/>
        <signed rend="paraph" rendition="#einrueck17">G</signed>
      </closer>
    </div>
    
  </body>
</text>


