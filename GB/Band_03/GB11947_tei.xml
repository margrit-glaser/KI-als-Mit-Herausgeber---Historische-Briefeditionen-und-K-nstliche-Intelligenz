<text xml:space="preserve"  xml:id="gb11947_source_hwit1425" corresp="#gb11947_header_hwit1425" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11947/22978"/>
      <p>
        <anchor xml:id="GB03_1_BR427_0_244_001"/>
        <ref target="gb:note#GB03_2_BR427_0_note_001_244_1" xml:id="start_com_3660"/>Friz hat mich vor vieren geweckt<ref xml:id="end_com_3660"/> und das neue Jahr herbey <ref target="gb:note#GB03_2_BR427_0_note_002_244_1" xml:id="start_com_3661"/>gegäckelt<ref xml:id="end_com_3661"/>. 
<anchor xml:id="GB03_1_BR427_0_244_002"/>Auch ein glücklichs neues Jahr liebste, und <ref target="gb:note#GB03_2_BR427_0_note_003_244_2" xml:id="start_com_3662"/>Zuckerbrodt<ref xml:id="end_com_3662"/>. Friz will 
<anchor xml:id="GB03_1_BR427_0_244_003"/>wieder fort. Wollen Sie mich <ref target="gb:note#GB03_2_BR427_0_note_004_244_3" xml:id="start_com_3663"/>heut zu Tische<ref xml:id="end_com_3663"/>?</p>
      <closer>
        <dateline rendition="#einrueck22">
          <anchor xml:id="GB03_1_BR427_0_244_004"/>79</dateline>
        <anchor xml:id="GB03_1_BR427_0_244_005"/>
        <signed rend="paraph" rendition="#einrueck23">G.</signed>
      </closer>
    </div>
  </body>
</text>


