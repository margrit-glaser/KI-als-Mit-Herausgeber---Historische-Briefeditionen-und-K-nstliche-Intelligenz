<text xml:space="preserve"  xml:id="gb11664_source_hwit1204" corresp="#gb11664_header_hwit1204" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11664/22605"/>
      <p>
        <anchor xml:id="GB03_1_BR263_0_146_009"/>Dancke für das <ref target="gb:note#GB03_2_BR263_0_note_001_146_9" xml:id="start_com_2252"/>Frühstück<ref xml:id="end_com_2252"/> hier schick ich <ref target="gb:note#GB03_2_BR263_0_note_002_146_9" xml:id="start_com_2253"/>etwas<ref xml:id="end_com_2253"/> dagegen. Heut Nacht 
<anchor xml:id="GB03_1_BR263_0_146_010"/>hab ich <ref target="gb:note#GB03_2_BR263_0_note_003_146_10" xml:id="start_com_2254"/>auf meinem Altan unterm blauen Mantel geschlafen<ref xml:id="end_com_2254"/>, bin dreymal 
<anchor xml:id="GB03_1_BR263_0_146_011"/>aufgewacht um 12, 2 und 4 und iedesmal <ref target="gb:note#GB03_2_BR263_0_note_004_146_11" xml:id="start_com_2255"/>neue Herrlichkeit<ref xml:id="end_com_2255"/> des 
<anchor xml:id="GB03_1_BR263_0_146_012"/>Himmels um mich. <ref target="gb:note#GB03_2_BR263_0_note_005_146_12" xml:id="start_com_2256"/>Zu Tische komm ich<ref xml:id="end_com_2256"/> wen mich nichts auffängt.
<anchor xml:id="GB03_1_BR263_0_146_013"/>   d<g ref="#typoSuspension"/>. 19 May</p>
      <closer>
        <dateline rendition="#einrueck17">
          <anchor xml:id="GB03_1_BR263_0_146_014"/>77  </dateline>
        <signed rend="paraph">G</signed>
      </closer>
    </div>
  </body>
</text>


