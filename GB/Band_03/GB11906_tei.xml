<text xml:space="preserve"  xml:id="gb11906_source_hwit1409" corresp="#gb11906_header_hwit1409" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11906/22950"/>
      <p>
        <anchor xml:id="GB03_1_BR414_0_237_007"/>
        <ref target="gb:note#GB03_2_BR414_0_note_001_237_7" xml:id="start_com_3579"/>Der Herzog hat besser Wetter zu seinem Ritt<ref xml:id="end_com_3579"/>, ich gonn’s Ihm, und 
<anchor xml:id="GB03_1_BR414_0_237_008"/>auch dass er sie sieht. Ich werde wieder was von Ihnen hören. Mein 
<anchor xml:id="GB03_1_BR414_0_237_009"/>Wesen geht in der Stille fort, <ref target="gb:note#GB03_2_BR414_0_note_002_237_9" xml:id="start_com_3580"/>wenn Sie wieder kommen<ref xml:id="end_com_3580"/> wird mein 
<anchor xml:id="GB03_1_BR414_0_237_010"/>Thal wieder lebendiger werden.    Adieu liebe. Grüsen Sie Stein und 
<anchor xml:id="GB03_1_BR414_0_237_011"/>
        <ref target="gb:note#GB03_2_BR414_0_note_003_237_11" xml:id="start_com_3581"/>die Kinder<ref xml:id="end_com_3581"/> und Kestnern.</p>
      <closer>
        <dateline rendition="#einrueck1">
          <anchor xml:id="GB03_1_BR414_0_237_012"/>d<g ref="#typoSuspension"/>. 15 Nov 78.</dateline>
        <anchor xml:id="GB03_1_BR414_0_237_013"/>
        <signed rend="paraph" rendition="#einrueck9">G.</signed>
      </closer>
    </div>
  </body>
</text>


