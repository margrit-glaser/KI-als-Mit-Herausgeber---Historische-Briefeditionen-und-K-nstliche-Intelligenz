    <pb n="1" facs="gb:digitalisate#12285/22404"/>
      <lg type="poem">
        <anchor xml:id="GB03_1_BR137_0_079_001"/>
        <l rendition="#einrueck6">Lass dir gefallen</l>
        <anchor xml:id="GB03_1_BR137_0_079_002"/>
        <l rendition="#einrueck6">
          <ref target="gb:note#GB03_2_BR137_0_note_001_79_2" xml:id="start_com_1250"/>Aus diesem Glas zu trincken<ref xml:id="end_com_1250"/>,</l>
        <anchor xml:id="GB03_1_BR137_0_079_003"/>
        <l rendition="#einrueck6">Und mög dir düncken</l>
        <anchor xml:id="GB03_1_BR137_0_079_004"/>
        <l rendition="#einrueck6">
          <ref target="gb:note#GB03_2_BR137_0_note_002_79_4" xml:id="start_com_1251"/>Wir<ref xml:id="end_com_1251"/> säsen neben dir</l>
        <anchor xml:id="GB03_1_BR137_0_079_005"/>
        <l rendition="#einrueck6">Denn obgleich <ref target="gb:note#GB03_2_BR137_0_note_003_79_5" xml:id="start_com_1252"/>fern<ref xml:id="end_com_1252"/> sind wir</l>
        <anchor xml:id="GB03_1_BR137_0_079_006"/>
        <l rendition="#einrueck6">Dir doch die nachsten fast</l>
        <anchor xml:id="GB03_1_BR137_0_079_007"/>
        <l rendition="#einrueck11">von allen.</l>
      </lg>
      <space quantity="1" unit="lines"/>
      <closer>
        <dateline rendition="#einrueck11">
          <anchor xml:id="GB03_1_BR137_0_079_008"/>
