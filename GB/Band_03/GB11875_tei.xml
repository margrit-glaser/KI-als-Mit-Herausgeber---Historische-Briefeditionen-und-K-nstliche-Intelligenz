<text xml:space="preserve"  xml:id="gb11875_source_hwit1383" corresp="#gb11875_header_hwit1383" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11875/22906"/>
      <p>
        <anchor xml:id="GB03_1_BR390_0_225_006"/>Es ist so heis dass ich <ref target="gb:note#GB03_2_BR390_0_note_001_225_6" xml:id="start_com_3391"/>die Sandwüste zu Ihnen<ref xml:id="end_com_3391"/> nicht durchwaten kann. 
<anchor xml:id="GB03_1_BR390_0_225_007"/>Ich sizze <ref target="gb:note#GB03_2_BR390_0_note_002_225_7" xml:id="start_com_3392"/>in der Einsiedeley<ref xml:id="end_com_3392"/> wohin ich mir das Essen bestellt habe. In 
<anchor xml:id="GB03_1_BR390_0_225_008"/>der Ruhe werd ich an Sie dencken wenn <ref target="gb:note#GB03_2_BR390_0_note_003_225_8" xml:id="start_com_3393"/>in der Pracht<ref xml:id="end_com_3393"/> Sie von andern 
<anchor xml:id="GB03_1_BR390_0_225_009"/>Gegenständen<ptr n="1" target="#a001_225.9"/> beschäfftigt seyn werden. <ref target="gb:note#GB03_2_BR390_0_note_004_225_9" xml:id="start_com_3394"/>Gegen Abend komm ich<ref xml:id="end_com_3394"/> aber, 
<anchor xml:id="GB03_1_BR390_0_225_010"/>und bin dann auch wieder neu. Adieu liebste. heut<ptr n="2" target="#a002_225.10"/> Nacht wars noch 
<anchor xml:id="GB03_1_BR390_0_225_011"/>gar schön</p>
      <closer>
        <dateline rendition="#einrueck1">
          <anchor xml:id="GB03_1_BR390_0_225_012"/>d<g ref="#typoSuspension"/>. 6 Aug 78      </dateline>
        <signed rend="paraph">G</signed>
      </closer>
      <postscript>
        <space quantity="1" unit="lines"/>
        <p>
          <anchor xml:id="GB03_1_BR390_0_225_013"/>
          <ref target="gb:note#GB03_2_BR390_0_note_005_225_13" xml:id="start_com_3395"/>Krause<ref xml:id="end_com_3395"/> hat mich beredt noch an dem <ref target="gb:note#GB03_2_BR390_0_note_006_225_13" xml:id="start_com_3396"/>Felsen<ptr n="3" target="#a003_225.13"/> werck<ref xml:id="end_com_3396"/> die lezte Hand anzulegen.
<anchor xml:id="GB03_1_BR390_0_225_014"/>
        </p>
      </postscript>
    </div>
    
