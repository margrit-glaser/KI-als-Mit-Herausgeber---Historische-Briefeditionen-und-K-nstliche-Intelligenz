<text xml:space="preserve"  xml:id="gb11656_source_hwit1187" corresp="#gb11656_header_hwit1187" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11656/22587"/>
      <p>
        <anchor xml:id="GB03_1_BR253_0_142_016"/>Vergebens hab ich auf <ref target="gb:note#GB03_2_BR253_0_note_001_142_16" xml:id="start_com_2204"/>die geheimnissvolle Ladung<ref xml:id="end_com_2204"/> gewartet, es wird 
<anchor xml:id="GB03_1_BR253_0_142_017"/>wohl nicht seyn. Gern schickt ich Ihnen ein Paar Aurickeln will sie 
<anchor xml:id="GB03_1_BR253_0_142_018"/>aber völlig aufblühen lassen. Schicken Sie mir nur ein wenig zu essen, 
<anchor xml:id="GB03_1_BR253_0_142_019"/>ich will <ref target="gb:note#GB03_2_BR253_0_note_002_142_19" xml:id="start_com_2205"/>im Stillen bleiben diesen Tag<ref xml:id="end_com_2205"/>.</p>
      <p rendition="#einrueck1">
        <anchor xml:id="GB03_1_BR253_0_142_020"/>Adieu beste es ist so gar schöne kamen Sie nicht etwa mit den 
<anchor xml:id="GB03_1_BR253_0_142_021"/>
        <ref target="gb:note#GB03_2_BR253_0_note_003_142_21" xml:id="start_com_2206"/>Misels<ref xml:id="end_com_2206"/>.   d. 29 Apr. 77</p>
      <closer>
        <anchor xml:id="GB03_1_BR253_0_142_022"/>
        <signed rend="paraph" rendition="#einrueck18">G.</signed>
      </closer>
    </div>
  </body>
</text>


