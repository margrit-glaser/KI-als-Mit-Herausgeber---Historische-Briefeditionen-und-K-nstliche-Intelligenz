<text xml:space="preserve"  xml:id="gb11899_source_hwit1401" corresp="#gb11899_header_hwit1401" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11899/22931"/>
      <p>
        <anchor xml:id="GB03_1_BR405_0_231_014"/>Wenn ich nach Hause komme, und etwas finde möcht ich’s Ihnen 
<anchor xml:id="GB03_1_BR405_0_231_015"/>gleich hinauf schicken, aber es ist <ref target="gb:note#GB03_2_BR405_0_note_001_231_15" xml:id="start_com_3509"/>wüst und leer<ref xml:id="end_com_3509"/>
        <ref target="gb:note#GB03_2_BR405_0_note_002_231_15" xml:id="start_com_3510"/>in Ihren Wohnungen<ref xml:id="end_com_3510"/>
        <anchor xml:id="GB03_1_BR405_0_231_016"/>und <ref target="gb:note#GB03_2_BR405_0_note_003_231_16" xml:id="start_com_3511"/>neu gemahlt<ref xml:id="end_com_3511"/>. Mögen denn <ref target="gb:note#GB03_2_BR405_0_note_004_231_16" xml:id="start_com_3512"/>die Pfirschen<ref xml:id="end_com_3512"/> über die Berge gehn und 
<anchor xml:id="GB03_1_BR405_0_231_017"/>Sie von mir grüsen. Es ist immer ebenderselbe, um nicht zu sagen immer 
<anchor xml:id="GB03_1_BR405_0_231_018"/>mehr derselbe der Ihnen guten Abend sagt d<g ref="#typoSuspension"/>. 1 Okter</p>
      <closer>
        <dateline rendition="#einrueck13">
          <anchor xml:id="GB03_1_BR405_0_231_019"/>1778   </dateline>
        <signed rend="paraph">G.</signed>
      </closer>
      <postscript>
        <p>
          <anchor xml:id="GB03_1_BR405_0_231_020"/>Grüsen Sie <ref target="gb:note#GB03_2_BR405_0_note_005_231_20" xml:id="start_com_3513"/>Stein und die Kinder<ref xml:id="end_com_3513"/>.</p>
      </postscript>
