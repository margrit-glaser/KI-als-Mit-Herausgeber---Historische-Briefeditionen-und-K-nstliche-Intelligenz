    <div>
    <pb n="1" facs="gb:digitalisate#11877/22912"/>
      <p>
        <anchor xml:id="GB03_1_BR394_0_227_005"/>Liebste Frau <ref target="gb:note#GB03_2_BR394_0_note_001_227_5" xml:id="start_com_3424"/>gestern bin ich weit in der Welt herum gezogen<ref xml:id="end_com_3424"/>, heut 
<anchor xml:id="GB03_1_BR394_0_227_006"/>hofft ich Sie zu sehen, der Herzog aber bestellt mich <ref target="gb:note#GB03_2_BR394_0_note_002_227_6" xml:id="start_com_3425"/>zum Jagen dahin<ref xml:id="end_com_3425"/>
        <anchor xml:id="GB03_1_BR394_0_227_007"/>geh ich gleich, also guten Morgen einen Straus und mein Andencken.
<anchor xml:id="GB03_1_BR394_0_227_008"/>    d<g ref="#typoSuspension"/>. 18 Aug 78</p>
      <closer>
        <anchor xml:id="GB03_1_BR394_0_227_009"/>
        <signed rend="paraph" rendition="#einrueck18">G.</signed>
      </closer>
    </div>
  </body>
</text>


