<text xml:space="preserve"  xml:id="gb10909_source_hwit991" corresp="#gb10909_header_hwit991" type="letter" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#10909/22355"/>
      <p>
        <anchor xml:id="GB03_1_BR121_0_072_005"/><ref target="gb:note#GB03_2_BR121_0_note_001_72_5" xml:id="start_com_1141"/>Ich bin wieder da<ref xml:id="end_com_1141"/>, wär so gern<ptr n="1" target="#a001_72.5"/> gekommen als ich lebe – aber es soll 
<anchor xml:id="GB03_1_BR121_0_072_006"/>nicht seyn – <ref target="gb:note#GB03_2_BR121_0_note_002_72_6-7" xml:id="start_com_1142"/>meine Abwesenheit wird die <hi rendition="#hervor1">Welt</hi> einigermaßen konsolirt 
<anchor xml:id="GB03_1_BR121_0_072_007"/>haben<ref xml:id="end_com_1142"/>. Ich bring Grüsse von <ref target="gb:note#GB03_2_BR121_0_note_003_72_7" xml:id="start_com_1143"/>der Guten Werthern<ref xml:id="end_com_1143"/>. Auch das 
<anchor xml:id="GB03_1_BR121_0_072_008"/><ref target="gb:note#GB03_2_BR121_0_note_004_72_8" xml:id="start_com_1144"/>Zettelgen<ref xml:id="end_com_1144"/> u. s. w.</p>
      <closer>
        <dateline rendition="#einrueck8">
          <anchor xml:id="GB03_1_BR121_0_072_009"/>d<g ref="#typoSuspension"/>. 1 Jun. 76</dateline><ptr n="2" target="#a002_72.9"/>
        <signed rend="paraph">G</signed>
      </closer>
    <pb n="2" facs="gb:digitalisate#10909/22356" type="empty"/>
    </div>
    
  </body>
</text>

