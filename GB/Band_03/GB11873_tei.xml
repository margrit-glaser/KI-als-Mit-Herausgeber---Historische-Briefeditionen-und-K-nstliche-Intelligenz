<text xml:space="preserve"  xml:id="gb11873_source_hwit1384" corresp="#gb11873_header_hwit1384" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11873/22903"/>
      <p>
        <anchor xml:id="GB03_1_BR389_0_225_001"/>
        <ref target="gb:note#GB03_2_BR389_0_note_001_225_1" xml:id="start_com_3385"/>Ein Bote aus fernen Landen<ref xml:id="end_com_3385"/>
        <ref target="gb:note#GB03_2_BR389_0_note_002_225_1" xml:id="start_com_3386"/>hat mich veranlasst<ref xml:id="end_com_3386"/>
        <ref target="gb:note#GB03_2_BR389_0_note_003_225_1-2" xml:id="start_com_3387"/>dem Herzog einen 
<anchor xml:id="GB03_1_BR389_0_225_002"/>Husaren zu schicken<ref xml:id="end_com_3387"/> den ich zurück erwarte, und eh nicht weg darf. 
<anchor xml:id="GB03_1_BR389_0_225_003"/>
        <ref target="gb:note#GB03_2_BR389_0_note_004_225_3" xml:id="start_com_3388"/>Sie sollen wie es scheint allein gehn.<ref xml:id="end_com_3388"/> Adieu. Wenns möglich ist <ref target="gb:note#GB03_2_BR389_0_note_005_225_3-4" xml:id="start_com_3389"/>komm 
<anchor xml:id="GB03_1_BR389_0_225_004"/>ich nach<ref xml:id="end_com_3389"/>
      </p>
      <closer>
        <dateline rendition="#einrueck4">
          <anchor xml:id="GB03_1_BR389_0_225_005"/>d<g ref="#typoSuspension"/>. 6<ptr n="1" target="#a001_225.5"/> Aug. 78.   </dateline>
        <signed rend="paraph">G</signed>
      </closer>
    </div>
    
  </body>
</text>


