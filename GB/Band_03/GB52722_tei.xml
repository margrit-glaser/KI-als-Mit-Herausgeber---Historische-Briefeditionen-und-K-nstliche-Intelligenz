<text xml:space="preserve"  xml:id="gb52722_source_hwit52894" corresp="#gb52722_header_hwit52894" type="source" rend="draft">
  <body>
    <div>
      <head><supplied>Konzept</supplied></head>
      <pb n="1" facs="gb:digitalisate#52722/12445"/>
      <lg type="poem">
        <anchor xml:id="GB03_1_BR450_0_254_005"/><head rendition="#einrueck6">Herdern.</head>
      <space quantity="1" unit="lines"/>
              <anchor xml:id="GB03_1_BR450_0_254_006"/>
        <l rendition="#einrueck5">Immer zu singen, die Stimme recht süsse</l>
        <anchor xml:id="GB03_1_BR450_0_254_007"/>
        <l rendition="#einrueck5">Und zum springen, federleichte Füsse</l>
        <anchor xml:id="GB03_1_BR450_0_254_008"/>
        <l rendition="#einrueck5">An den <emph rendition="#latin">
            <ref target="gb:note#GB03_2_BR450_0_note_001_254_8" xml:id="start_com_3701"/>Pot de chambre</emph>
          <ref xml:id="end_com_3701"/> einen festen Henkel</l>
        <anchor xml:id="GB03_1_BR450_0_254_009"/>
        <l rendition="#einrueck5">Und zum reiten derbe Schenkel</l>
        <anchor xml:id="GB03_1_BR450_0_254_010"/>
        <l rendition="#einrueck5">Und auf das Eis</l>
        <anchor xml:id="GB03_1_BR450_0_254_011"/>
        <l rendition="#einrueck5">Einen tüchtigen Steiss.</l>
      </lg>
    </div>
  </body>
</text>


