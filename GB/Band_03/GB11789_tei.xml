<text xml:space="preserve"  xml:id="gb11789_source_hwit1266" corresp="#gb11789_header_hwit1266" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11789/22726"/>
      <p>
        <anchor xml:id="GB03_1_BR302_0_175_007"/>Die Welt war <ref target="gb:note#GB03_2_BR302_0_note_001_175_7" xml:id="start_com_2630"/>gestern Nacht<ref xml:id="end_com_2630"/> unendlich schön, sie schien mir den ganzen 
<anchor xml:id="GB03_1_BR302_0_175_008"/>Sommer nicht so. Es ist gewiss dass der Gegensaz nur einen das<ptr n="1" target="#a001_175.8"/>
        <anchor xml:id="GB03_1_BR302_0_175_009"/>hohe schöne fühlen macht. Ade.   hier <ref target="gb:note#GB03_2_BR302_0_note_002_175_9" xml:id="start_com_2631"/>Trauben<ref xml:id="end_com_2631"/>.    d<g ref="#typoSuspension"/>. 10 Nov. 77.</p>
      <closer>
        <anchor xml:id="GB03_1_BR302_0_175_010"/>
        <signed rend="paraph" rendition="#einrueck18">G.</signed>
      </closer>
      <postscript>
        <p>
          <anchor xml:id="GB03_1_BR302_0_175_011"/>Mich haben gestern <ref target="gb:note#GB03_2_BR302_0_note_003_175_11" xml:id="start_com_2632"/>Herders Picks auf Z.<ref xml:id="end_com_2632"/> gefreut.</p>
      </postscript>
    </div>
    
  </body>
</text>


