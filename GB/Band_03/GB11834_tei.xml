    <div>
    <pb n="1" facs="gb:digitalisate#11834/22803"/>
      <p>
        <anchor xml:id="GB03_1_BR335_0_199_001"/>Ihren <ref target="gb:note#GB03_2_BR335_0_note_001_199_1" xml:id="start_com_3018"/>Friz<ref xml:id="end_com_3018"/> mit Blumen und Früchten schick ich Ihnen wieder das ist 
<anchor xml:id="GB03_1_BR335_0_199_002"/>das schönste was mir <ref target="gb:note#GB03_2_BR335_0_note_002_199_2" xml:id="start_com_3019"/>iezt die Welt hat<ref xml:id="end_com_3019"/>. Er mag ihnen unsre Possen 
<anchor xml:id="GB03_1_BR335_0_199_003"/>und leben erzählen. Adieu    d<g ref="#typoSuspension"/>. 7 März 78</p>
      <closer>
        <anchor xml:id="GB03_1_BR335_0_199_004"/>
        <signed rend="paraph" rendition="#einrueck17">G.</signed>
      </closer>
    </div>
  </body>
</text>


