<text xml:space="preserve"  xml:id="gb11671_source_hwit1208" corresp="#gb11671_header_hwit1208" type="source" rend="authorisedLetter">
  <body>
    <div>
    <pb n="1" facs="gb:digitalisate#11671/22613"/>
      <p>
        <anchor xml:id="GB03_1_BR268_0_148_001"/>
        <ref target="gb:note#GB03_2_BR268_0_note_001_148_1" xml:id="start_com_2280"/>Ihr Zettelgen<ref xml:id="end_com_2280"/> erhielt ich gestern Nacht als ich um 10 wieder aufwachte 
<anchor xml:id="GB03_1_BR268_0_148_002"/>ich hatte mich um achte auf einen Strohsack im <ref target="gb:note#GB03_2_BR268_0_note_002_148_2" xml:id="start_com_2281"/>Altan Stübgen<ref xml:id="end_com_2281"/>
        <anchor xml:id="GB03_1_BR268_0_148_003"/>niedergelegt und war glücklich eingeschlafen. Heut sollt ich einmal 
<anchor xml:id="GB03_1_BR268_0_148_004"/>nicht kommen. Es ist gar frisch und herrlich im Regen hier.   Adieu 
<anchor xml:id="GB03_1_BR268_0_148_005"/>beste.   d<g ref="#typoSuspension"/> 27 May. 77</p>
      <closer>
        <anchor xml:id="GB03_1_BR268_0_148_006"/>
        <signed rend="paraph" rendition="#einrueck16">G</signed>
      </closer>
    </div>
  </body>
</text>


