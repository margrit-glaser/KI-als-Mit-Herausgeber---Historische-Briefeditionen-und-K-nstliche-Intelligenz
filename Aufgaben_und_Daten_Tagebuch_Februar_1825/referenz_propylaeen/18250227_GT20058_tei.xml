<body>
<div type="diaryEntry">
<dateline><supplied><placeName key="SNDB79627" type="uebernachtungsort"/></supplied>
<lb/><date when="1825-02-27"><hi rendition="#u">Sonntag</hi> <abbr>d<g ref="#typoSuspension"/>.</abbr> 27. <abbr><hi rendition="#latin">ejd.</hi></abbr></date></dateline>
<div type="diaryText">
<p>
<lb/><anchor type="Begegnungen-Meteorologie/Wetter" xml:id="gt20058_lemText010"/><rs type="person" key="sndb:person#44302"><abbr>Secr.</abbr> Kräuter</rs>, wegen de<subst><del rendition="#ow">r</del><add place="across">s</add></subst>
<lb/><abbr>Meteorolog<g ref="#typoSuspension"/>.</abbr> Abdrucks.<anchor corresp="#gt20058_lemText010"/> <anchor type="Briefausgangsnotiz" xml:id="gt20058_lemText020"/>Munda
<lb/>der Briefe an <rs type="person" key="sndb:person#40609">Reinhard</rs>
<lb/>und <rs type="person" key="sndb:person#43135">Beust</rs> nach <rs type="place" key="sndb:ort#77853">Frankfurt</rs>.<anchor corresp="#gt20058_lemText020"/>
<lb/><anchor type="Werkentstehung" xml:id="gt20058_lemText030"/><rs type="person" key="sndb:person#44570">Meyers</rs> Aufsatz zu <abbr>K.</abbr> <abbr>u</abbr>
<lb/><abbr>Alterth.</abbr> mundirt.<anchor corresp="#gt20058_lemText030"/> <anchor type="Begegnungen" xml:id="gt20058_lemText040"/><rs type="person" key="sndb:person#43691">Der
<lb/>junge Frommann</rs>.<anchor corresp="#gt20058_lemText040"/> <anchor type="Mittag" xml:id="gt20058_lemText050"/>Mittag
<lb/><rs type="person" key="sndb:person#36828"><abbr>Dr.</abbr> Eckermann</rs>.<anchor corresp="#gt20058_lemText050"/> <anchor type="Familienangelegenheiten" xml:id="gt20058_lemText060"/><rs type="person" key="sndb:person#43780">Mein Sohn</rs> hatte
<lb/>den Hofdienst.<anchor corresp="#gt20058_lemText060"/> <anchor type="Lektüre" xml:id="gt20058_lemText070"/><rs type="place" key="sndb:ort#79565">Venetianische</rs>
<lb/>Sonette des <rs type="person" key="sndb:person#40355">Grafen Platen</rs>,
<lb/>lobenswürdig gefunden.<anchor corresp="#gt20058_lemText070"/> <anchor type="Werkentstehung" xml:id="gt20058_lemText080"/>Be<g ref="#typoHyphen"/>
<lb break="no"/>trachtungen über Faust. Die
<lb/>ältern Nacharbeitungen
<lb/>vorgenommen. Einiges zu
<lb/>rechte gestellt.<anchor corresp="#gt20058_lemText080"/> <del rendition="#s"><g ref="#NB"/> <rs type="person" key="sndb:person#44302">Kräuter</rs>
<lb/>hatte früh <abbr>u.</abbr></del> <anchor type="Begegnungen" xml:id="gt20058_lemText090"/><rs type="person" key="sndb:person#37707"><abbr>Ober Consistor.</abbr>
<lb/>Rath Günther</rs>, Kohle und Holz
<lb/><abbr>v.</abbr> <rs type="place" key="sndb:ort#78549">Mattstett</rs> bringend.
<pb type="v" facs="gt:digitalisate#27/11342/11342_56.jpg"/>
<lb/><fw><abbr><hi rendition="#latin">Febr.</hi></abbr></fw>
<lb/>Zeigte <rs type="person" key="sndb:person#37707">ihm</rs> die <hi rendition="#latin">flora subterranea</hi>
<lb/>des <rs type="person" key="sndb:person#49782">Grafen Sternberg</rs> und eini<g ref="#typoHyphen"/>
<lb break="no"/>ge Musterstücke vor.<anchor corresp="#gt20058_lemText090"/> <anchor type="Briefeingangsnotiz" xml:id="gt20058_lemText100"/>Billet
<lb/>von <rs type="person" key="sndb:person#36828">Eckermann</rs>, wegen einer
<lb/><rs type="person" key="sndb:person#78040">Hannöverischen</rs> Anstellung.<anchor corresp="#gt20058_lemText100"/>
</p>
</div>
<div type="exped">
<pb type="r" facs="gt:digitalisate#27/11342/11342_55.jpg"/>
<list>
<item><anchor type="Briefausgangsnotiz" xml:id="gt20058_lemExped020"/><lb/><abbr>H<g ref="#typoSuspension"/>.</abbr> Grafen <hi rendition="#u">Reinhard</hi> nach
<lb/><abbr>Frkfrt</abbr> <abbr>a/m</abbr><anchor corresp="#gt20058_lemExped020"/></item>
<item><anchor type="Briefausgangsnotiz" xml:id="gt20058_lemExped030"/><lb/><abbr>H<g ref="#typoSuspension"/>.</abbr> <hi rendition="#u">Velten</hi>, nach Carlsruhe
<lb/>mit einer Rolle. 
<lb/>Gingen erst Morgen ab.<anchor corresp="#gt20058_lemExped010"/><anchor corresp="#gt20058_lemExped030"/></item>
</list>
</div>
</div>
</body>
</text>
